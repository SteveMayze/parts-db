DJANGO_DEBUG_FALSE=1
DJANGO_SECRET_KEY={{ django_secret_key }}
DJANGO_ALLOWED_HOSTS={{ (django_allowed_hosts | default([django_allowed_host | default(inventory_hostname)])) | join(',') }}
DJANGO_URL_PREFIX={{ url_prefix | default('') }}
DJANGO_BEHIND_TLS_PROXY={{ '1' if behind_tls_proxy | default(false) | bool else '' }}
DJANGO_CSRF_TRUSTED_ORIGINS={{ csrf_trusted_origins | default([]) | join(',') }}
