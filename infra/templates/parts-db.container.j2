[Unit]
Description=Parts DB web app (Podman Quadlet)
After=network-online.target
Wants=network-online.target

[Container]
Image={{ image_name }}
ContainerName={{ app_name }}-web
PublishPort={{ app_port | default(8888) }}:8000
Volume={{ app_data_dir }}/db.sqlite3:/app/db.sqlite3:Z
Volume={{ app_static_dir }}:/app/staticfiles:Z
Environment=DJANGO_DEBUG_FALSE=1
Environment=DJANGO_SECRET_KEY={{ django_secret_key }}
Environment=DJANGO_ALLOWED_HOST={{ django_allowed_host | default(inventory_hostname) }}
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
